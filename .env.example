# ---------------------------------------------------------------------------
# Goodly & Chic — demo environment
# Copy to `.env.local` and fill in real values.
# ---------------------------------------------------------------------------

# WhatsApp number in international format, digits only, no "+" and no spaces.
# Demo default: 2340000000000 (placeholder — replace before sharing the demo).
NEXT_PUBLIC_WHATSAPP_NUMBER=2340000000000

# Set to "true" to silence the `track()` console logger in the browser.
# NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Site URL used for canonical links, Open Graph images and the sitemap.
NEXT_PUBLIC_SITE_URL=https://goodlyandchic.com
